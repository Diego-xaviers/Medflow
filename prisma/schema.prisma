// Schema do Medflow
//
// Regra de ouro do multi-tenant: TODA tabela de dados carrega consultorioId.
// Nenhuma consulta pode rodar sem esse filtro — quem garante isso é o
// helper em src/lib/tenant.ts, que monta o cliente Prisma já amarrado
// ao consultório da sessão.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// O tenant. Cada optometrista tem o seu.
model Consultorio {
  id       String  @id @default(cuid())
  nome     String
  /// Usado na URL pública de agendamento: /agendar/{slug}
  slug     String  @unique
  telefone String?
  endereco String?

  /// Logo da clínica, como data URI. Sai no cabeçalho da receita impressa.
  /// Mesma escolha da foto de perfil: sem storage de arquivos contratado, e
  /// a imagem é recortada e reduzida no navegador antes de subir. Guardada em
  /// PNG para preservar transparência — logo sobre fundo branco é o caso.
  logoUrl String? @db.Text

  /// Quanto dura cada atendimento. Junto com os blocos de expediente, é o que
  /// define os horários que o link público oferece.
  duracaoConsultaMin Int      @default(30)
  /// Fuso da clínica, no padrão IANA. Precisa existir: o servidor roda em UTC
  /// na Vercel, então "abre às 8h" sem fuso viraria 8h UTC — 5h da manhã aqui.
  /// E o Brasil tem mais de um fuso: Cuiabá é UTC-4, São Paulo é UTC-3.
  fusoHorario        String   @default("America/Sao_Paulo")
  ativo              Boolean  @default(true)
  criadoEm           DateTime @default(now())

  /// Dia do mês de vencimento (1-28). Quando preenchido, o formulário de
  /// nova fatura auto-preenche o campo vencimento com base na competência.
  diaVencimento Int?

  /// Libera o acesso manualmente, ignorando o bloqueio automático por
  /// inadimplência. Útil quando o admin decide dar carência extra.
  acessoLiberado Boolean @default(false)

  /// Conta que precisa pagar a primeira mensalidade antes de usar o sistema.
  /// Marcada só pelo cadastro público: quem entra sozinho pela vitrine paga
  /// para entrar. Cliente criado pelo admin nasce `false` — a cobrança dele é
  /// negociada fora do sistema, e ligar isto trancaria quem já é cliente.
  exigePagamentoInicial Boolean @default(false)

  /// Plano contratado. Define o que o consultório enxerga; o preço de tabela
  /// vive em `src/lib/planos.ts` e serve só para exibir.
  ///
  /// BASICO por padrão para que consultório novo nasça no menor plano — nunca
  /// entregando feature paga por omissão.
  plano Plano @default(BASICO)

  /// Mensalidade cobrada deste consultório, definida pelo administrador.
  /// É o valor da assinatura no Asaas.
  valorMensalidade  Decimal? @db.Decimal(10, 2)
  /// CPF ou CNPJ de quem paga — o Asaas exige para emitir cobrança e nota.
  documentoCobranca String?
  /// Vínculo com o Asaas. O cartão nunca passa pelo Medflow: fica no Asaas,
  /// e aqui só guardamos os ids para conversar com ele.
  asaasClienteId    String?  @unique
  asaasAssinaturaId String?  @unique
  /// PIX ou CREDIT_CARD — forma escolhida pelo dono na tela Cobrança.
  formaCobranca     String?

  usuarios        Usuario[]
  pacientes       Paciente[]
  consultas       Consulta[]
  lancamentos     Lancamento[]
  prontuarios     Prontuario[]
  receitas        Receita[]
  encaminhamentos Encaminhamento[]
  ausencias       Ausencia[]
  acessosExtras   AcessoConsultorio[]
  tetosAcesso     TetoAcesso[]

  /// Rede de que este consultório faz parte (vínculo criado pelo admin).
  redeId           String?
  rede             Rede?             @relation(fields: [redeId], references: [id], onDelete: SetNull)
  notificacoes     Notificacao[]
  blocosExpediente BlocoExpediente[]
  faturas          Fatura[]
  chamados         Chamado[]
  logsAuditoria    LogAuditoria[]
  campanhas        Campanha[]
  metasFinanceiras MetaFinanceira[]
  lotesIA          LoteIA[]

  /// Assistente IA: aprova lotes novos sozinho e prepara os contatos do dia.
  /// O envio automático (sem clique) chega com o WhatsApp oficial, na etapa 2.
  iaModoAutomatico  Boolean              @default(false)
  iaRitmoAutomatico Int                  @default(20)
  contatosLote      ContatoLote[]
  analisesIA        AnaliseIA[]
  conversasIA       ConversaIA[]
  agentesIA         AgenteIA[]
  conhecimentoIA    ItemConhecimentoIA[]

  /// WhatsApp via Z-API (etapa 2): uma instância por consultório. O segredo
  /// vai na URL do webhook para identificar a clínica sem confiar no corpo.
  whatsappStatus            StatusWhatsapp @default(SEM_INSTANCIA)
  whatsappInstanciaId       String?
  whatsappInstanciaToken    String?
  whatsappSegredoWebhook    String?        @unique
  whatsappNumero            String?
  /// Pós-venda automático: só liga com autorização registrada de quem aceitou.
  iaPosVendaLigada          Boolean        @default(false)
  iaPosVendaAutorizadaPorId String?
  iaPosVendaAutorizadaEm    DateTime?
  limiteDiarioEnvios        Int            @default(20)

  @@map("consultorios")
}

/// Os três planos comerciais do Medflow.
///
/// O enum governa FEATURES. Quem governa DINHEIRO continua sendo
/// `valorMensalidade`, que o administrador digita e o Asaas cobra — e é isso
/// que permite preço negociado e desconto de rede sem regra no código.
enum Plano {
  BASICO
  PRO
  ULTRA
}

enum Papel {
  SUPER_ADMIN
  DONO
  ATENDENTE
  VENDEDORA
  /// Administra uma Rede de consultórios: vê os dados somados e cuida da
  /// equipe. Não pertence a consultório nenhum, como o SUPER_ADMIN.
  GESTOR
}

model Usuario {
  id        String   @id @default(cuid())
  nome      String
  email     String   @unique
  senhaHash String
  papel     Papel
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now())

  /// Foto de perfil como data URI. Fica no banco porque o projeto não tem
  /// storage de arquivos contratado — a imagem é reduzida no navegador antes
  /// de subir, então cada uma ocupa poucas dezenas de KB.
  fotoUrl String? @db.Text

  /// Atende pacientes? Quem estiver marcado aparece como profissional
  /// escolhível no link público de agendamento.
  atendePacientes Boolean @default(false)

  /// Registro no conselho de classe, impresso na receita. São dois campos
  /// porque o conselho varia com a formação: optometrista usa CBOO, médico
  /// usa CRM, e a via impressa precisa dizer qual é qual.
  conselhoProfissional String?
  registroProfissional String?

  /// Telas que o dono liberou para esta pessoa (em Equipe). Vazio = padrão
  /// do papel. Só vale para a equipe: o dono nunca é restringido.
  telas String[] @default([])

  /// Rede que esta pessoa gere. Papel GESTOR sempre tem; um DONO pode ter
  /// também, e aí ganha o ambiente gestor além da própria clínica.
  redeId String?
  rede   Rede?   @relation(fields: [redeId], references: [id], onDelete: SetNull)

  /// Modelo antigo de multi-unidade, substituído por Rede. Mantido só até a
  /// migração dos vínculos existentes.
  acessosExtras AcessoConsultorio[]

  /// Nulo apenas para o SUPER_ADMIN, que está acima dos consultórios.
  consultorioId String?
  consultorio   Consultorio? @relation(fields: [consultorioId], references: [id], onDelete: Cascade)

  consultasComoProfissional Consulta[]       @relation("ProfissionalDaConsulta")
  consultasCriadas          Consulta[]       @relation("CriadorDaConsulta")
  receitasComoProfissional  Receita[]        @relation("ProfissionalDaReceita")
  encaminhamentosEmitidos   Encaminhamento[] @relation("ProfissionalDoEncaminhamento")
  ausencias                 Ausencia[]
  notificacoes              Notificacao[]
  chamados                  Chamado[]
  logsAuditoria             LogAuditoria[]

  @@index([consultorioId])
  @@map("usuarios")
}

model Paciente {
  id             String    @id @default(cuid())
  nome           String
  email          String?
  telefone       String?
  dataNascimento DateTime?
  ativo          Boolean   @default(true)
  criadoEm       DateTime  @default(now())

  // Documento e endereço — necessários para emitir receita e para contato
  cpf       String?
  rg        String?
  sexo      String?
  profissao String?

  cep         String?
  logradouro  String?
  numero      String?
  complemento String?
  bairro      String?
  cidade      String?
  estado      String?

  // Contexto clínico rápido, que o optometrista quer ver antes do atendimento
  convenio          String?
  observacoesGerais String?

  /// Como o paciente chegou até a clínica (indicação, Instagram, link online...)
  origemContato String?

  consultorioId String
  consultorio   Consultorio @relation(fields: [consultorioId], references: [id], onDelete: Cascade)

  consultas    Consulta[]
  prontuarios  Prontuario[]
  receitas     Receita[]
  lancamentos  Lancamento[]
  contatosLote ContatoLote[]
  conversasIA  ConversaIA[]

  /// "Não quero receber": o Assistente IA nunca mais propõe este paciente.
  aceitaContato Boolean @default(true)

  @@index([consultorioId])
  @@map("pacientes")
}

enum StatusConsulta {
  AGENDADA
  CONCLUIDA
  FALTA
  CANCELADA
}

model Consulta {
  id             String          @id @default(cuid())
  dataHora       DateTime
  status         StatusConsulta  @default(AGENDADA)
  valor          Decimal?        @db.Decimal(10, 2)
  formaPagamento FormaPagamento?
  observacoes    String?

  /// Preenchidos quando a consulta nasce do link público de agendamento.
  telefoneContato      String?
  vendedoraResponsavel String?
  origemPublica        Boolean @default(false)

  pacienteId String
  paciente   Paciente @relation(fields: [pacienteId], references: [id], onDelete: Cascade)

  /// Quem vai atender. Sem isto, dois profissionais não poderiam receber
  /// pacientes no mesmo horário — a agenda seria de uma pessoa só.
  /// Obrigatório de propósito: com a coluna anulável, a trava única abaixo
  /// não valeria para linhas sem profissional (no Postgres, NULL nunca colide
  /// com NULL) e o mesmo horário poderia ser vendido duas vezes.
  profissionalId String
  profissional   Usuario @relation("ProfissionalDaConsulta", fields: [profissionalId], references: [id], onDelete: Cascade)

  /// Quem criou o agendamento internamente (nulo para agendamentos públicos).
  criadoPorId String?
  criadoPor   Usuario? @relation("CriadorDaConsulta", fields: [criadoPorId], references: [id], onDelete: SetNull)

  consultorioId String
  consultorio   Consultorio @relation(fields: [consultorioId], references: [id], onDelete: Cascade)

  prontuario Prontuario?

  /// Receita que esta consulta gerou no Financeiro. Quem mantém é
  /// src/lib/financeiro.ts — nenhuma rota grava esse lançamento por conta.
  lancamento Lancamento? @relation("ReceitaDaConsulta")

  /// O paciente desta consulta de campanha fechou compra na ótica. Marcado
  /// pelo dono ou pelo optometrista; gera o complemento abaixo.
  vendaFechada   Boolean     @default(false)
  vendaFechadaEm DateTime?
  /// Diferença até o valor de referência da campanha (100 − 59,90), devida
  /// quando a venda fecha. Mantido por src/lib/financeiro.ts.
  complemento    Lancamento? @relation("ComplementoDaConsulta")

  /// Campanha que trouxe esta consulta. Anulável: a maioria não vem de uma.
  campanhaId String?
  campanha   Campanha? @relation(fields: [campanhaId], references: [id], onDelete: SetNull)

  /// Impede dois agendamentos no mesmo horário COM O MESMO PROFISSIONAL —
  /// a trava real é aqui no banco, não só na validação da aplicação.
  @@unique([consultorioId, profissionalId, dataHora])
  @@index([consultorioId, dataHora])
  @@index([campanhaId])
  @@map("consultas")
}

/// Como o paciente pagou. Fica na consulta e passa para o lançamento que
/// ela gera, para o Financeiro saber quanto entrou por cada meio.
enum FormaPagamento {
  DINHEIRO
  PIX
  CARTAO_DEBITO
  CARTAO_CREDITO
  CHEQUE
  BOLETO
  CONVENIO
  OUTRO
}

enum TipoLancamento {
  RECEITA
  DESPESA
}

enum StatusPagamento {
  PAGO
  PENDENTE
}

model Lancamento {
  id             String          @id @default(cuid())
  descricao      String
  valor          Decimal         @db.Decimal(10, 2)
  tipo           TipoLancamento
  status         StatusPagamento @default(PENDENTE)
  data           DateTime
  formaPagamento FormaPagamento?

  pacienteId String?
  paciente   Paciente? @relation(fields: [pacienteId], references: [id], onDelete: SetNull)

  /// Preenchido quando o lançamento nasceu de uma consulta com valor. Único:
  /// uma consulta gera no máximo uma receita, por mais vezes que seja editada.
  consultaId String?   @unique
  consulta   Consulta? @relation("ReceitaDaConsulta", fields: [consultaId], references: [id], onDelete: SetNull)

  /// Preenchido no lançamento da diferença de campanha (venda fechada na
  /// ótica). Receita quando a ótica parceira paga; despesa quando a clínica
  /// paga ao optometrista.
  complementoDeId String?   @unique
  complementoDe   Consulta? @relation("ComplementoDaConsulta", fields: [complementoDeId], references: [id], onDelete: SetNull)

  consultorioId String
  consultorio   Consultorio @relation(fields: [consultorioId], references: [id], onDelete: Cascade)

  @@index([consultorioId, data])
  @@map("lancamentos")
}

/// Quem cobre a diferença até o valor de referência quando a venda fecha.
enum QuemPagaDiferenca {
  /// A clínica/ótica que usa o Medflow paga ao optometrista: despesa.
  CLINICA_PAGA
  /// A ótica parceira paga ao consultório que usa o Medflow: receita.
  PARCEIRO_PAGA
}

/// Campanha de venda: "Exame + armação com 20% off até 31/10". Uma venda é
/// uma consulta CONCLUÍDA ligada à campanha — o resultado sai da agenda e
/// nunca precisa ser digitado. Aqui só ficam a oferta e a meta.
model Campanha {
  id                 String   @id @default(cuid())
  nome               String
  /// O que está sendo oferecido, em texto livre.
  descricao          String?
  /// Dias inteiros, ancorados ao meio-dia: "ativa" é hoje entre os dois.
  inicio             DateTime
  fim                DateTime
  /// A oferta: preço fechado OU desconto sobre o valor de tabela. Os dois
  /// vazios = campanha sem condição de preço (ex.: "brinde na compra").
  precoPromocional   Decimal? @db.Decimal(10, 2)
  descontoPercentual Int?
  /// Quantas vendas a campanha precisa fechar.
  metaVendas         Int?

  /// Valor cheio da consulta (ex.: 100). Com ele, a consulta que fechar
  /// venda na ótica gera a diferença até este valor.
  valorReferencia   Decimal?           @db.Decimal(10, 2)
  quemPagaDiferenca QuemPagaDiferenca?
  /// Ótica parceira que paga a diferença (quando é ela quem paga).
  parceiroNome      String?
  criadoEm          DateTime           @default(now())

  consultas Consulta[]

  consultorioId String
  consultorio   Consultorio @relation(fields: [consultorioId], references: [id], onDelete: Cascade)

  @@index([consultorioId, inicio])
  @@map("campanhas")
}

/// Meta de faturamento de um mês. Uma por mês por consultório.
model MetaFinanceira {
  id          String  @id @default(cuid())
  /// Mês no formato AAAA-MM.
  competencia String
  valor       Decimal @db.Decimal(10, 2)

  consultorioId String
  consultorio   Consultorio @relation(fields: [consultorioId], references: [id], onDelete: Cascade)

  @@unique([consultorioId, competencia])
  @@map("metas_financeiras")
}

/// PRONTUÁRIO — registro do EXAME.
/// Tudo aqui é achado clínico: o que o paciente relata e o que o
/// optometrista mede/observa. A prescrição final NÃO fica aqui.
model Prontuario {
  id        String   @id @default(cuid())
  dataExame DateTime @default(now())

  // Anamnese
  queixaPrincipal    String?
  historicoOcular    String?
  historicoSistemico String?
  medicamentosEmUso  String?
  usaCorrecaoAtual   Boolean @default(false)
  tempoUltimoExame   String?
  /// Para que o paciente precisa da correção: uso contínuo, leitura,
  /// computador, dirigir... Orienta o tipo de lente e vai para a receita.
  necessidadeUso     String?

  /// Grau dos óculos que o paciente JÁ USA (o antigo). Serve de comparação
  /// com a refração encontrada e explica a acuidade "com correção atual".
  grauAtualEsfericoOD   String?
  grauAtualCilindricoOD String?
  grauAtualEixoOD       String?
  grauAtualEsfericoOE   String?
  grauAtualCilindricoOE String?
  grauAtualEixoOE       String?
  grauAtualAdicaoOD     String?
  grauAtualAdicaoOE     String?
  tipoLenteAtual        TipoLente?

  // Acuidade visual SEM correção
  avSemCorrecaoOD String?
  avSemCorrecaoOE String?

  // Acuidade visual COM a correção que o paciente já usa
  avComCorrecaoOD String?
  avComCorrecaoOE String?

  // Refração encontrada no exame (achado, não prescrição)
  refracaoEsfericoOD   String?
  refracaoCilindricoOD String?
  refracaoEixoOD       String?
  refracaoEsfericoOE   String?
  refracaoCilindricoOE String?
  refracaoEixoOE       String?

  // Adição (presbiopia) — herdada pela receita para não redigitar
  adicaoOD String?
  adicaoOE String?

  // Exames complementares
  biomicroscopia    String?
  tonometriaOD      String?
  tonometriaOE      String?
  fundoscopia       String?
  motilidadeOcular  String?
  testeCobertura    String?
  reflexosPupilares String?
  visaoCores        String?

  // Conclusão
  diagnostico String?
  conduta     String?
  observacoes String?

  pacienteId String
  paciente   Paciente @relation(fields: [pacienteId], references: [id], onDelete: Cascade)

  consultaId String?   @unique
  consulta   Consulta? @relation(fields: [consultaId], references: [id], onDelete: SetNull)

  consultorioId String
  consultorio   Consultorio @relation(fields: [consultorioId], references: [id], onDelete: Cascade)

  receitas Receita[]

  @@index([consultorioId, pacienteId])
  @@map("prontuarios")
}

/// Quem assina define o nome do documento: optometrista emite receita
/// optométrica, médico emite oftálmica. Muda o título impresso e é o que a
/// ótica confere na hora de montar a lente.
enum TipoReceita {
  OFTALMOLOGICA
  OPTOMETRICA
}

enum TipoLente {
  MONOFOCAL
  BIFOCAL
  MULTIFOCAL
  OCUPACIONAL
  CONTATO
}

/// RECEITA — a PRESCRIÇÃO final entregue ao paciente.
/// Sem repetir campo de exame: aqui só entra o que vai para a ótica montar
/// a lente. O grau abaixo é o prescrito, que pode diferir do achado no exame
/// (o optometrista costuma ajustar por conforto/adaptação).
model Receita {
  id          String   @id @default(cuid())
  dataEmissao DateTime @default(now())
  validadeAte DateTime

  // Longe
  longeEsfericoOD   String?
  longeCilindricoOD String?
  longeEixoOD       String?
  longeEsfericoOE   String?
  longeCilindricoOE String?
  longeEixoOE       String?

  // Perto
  pertoEsfericoOD   String?
  pertoCilindricoOD String?
  pertoEixoOD       String?
  pertoEsfericoOE   String?
  pertoCilindricoOE String?
  pertoEixoOE       String?

  // Adição (presbiopia)
  adicaoOD String?
  adicaoOE String?

  /// Acuidade visual ALCANÇADA com o grau que está sendo prescrito.
  ///
  /// Não é repetição do prontuário: lá ficam a AV sem correção e a AV com o
  /// óculos que o paciente JÁ USA — duas medidas do estado atual. Esta aqui é
  /// o resultado esperado da lente nova, e é o número que responde à pergunta
  /// que todo paciente faz: "com esse óculos eu vou enxergar quanto?".
  avCorrigidaOD String?
  avCorrigidaOE String?

  /// Mesma ideia da AV acima, medida para perto (tabela de leitura: J1,
  /// 0.4M...). A de cima é a de longe; as duas juntas respondem por leitura e
  /// por rua, que é o que importa em quem usa multifocal ou óculos de perto.
  avPertoOD String?
  avPertoOE String?

  // Distância pupilar e altura de montagem
  dpLongeOD String?
  dpLongeOE String?
  dpPerto   String?
  alturaOD  String?
  alturaOE  String?

  // Prisma, quando indicado
  prismaOD     String?
  baseprismaOD String?
  prismaOE     String?
  baseprismaOE String?

  // Indicação da lente
  tipoLente      TipoLente @default(MONOFOCAL)
  materialLente  String?
  tratamentos    String?
  orientacoesUso String?

  pacienteId String
  paciente   Paciente @relation(fields: [pacienteId], references: [id], onDelete: Cascade)

  tipoReceita TipoReceita @default(OPTOMETRICA)

  /// Quem prescreveu. Anulável de propósito: as receitas emitidas antes deste
  /// campo existir não têm como saber quem as assinou, e inventar um autor
  /// seria pior que admitir a lacuna. Toda receita nova nasce preenchida.
  profissionalId String?
  profissional   Usuario? @relation("ProfissionalDaReceita", fields: [profissionalId], references: [id], onDelete: SetNull)

  prontuarioId String?
  prontuario   Prontuario? @relation(fields: [prontuarioId], references: [id], onDelete: SetNull)

  consultorioId String
  consultorio   Consultorio @relation(fields: [consultorioId], references: [id], onDelete: Cascade)

  @@index([consultorioId, pacienteId])
  @@map("receitas")
}

/// Encaminhamento em texto livre, escrito pelo próprio profissional. O
/// paciente vai por nome digitado, não por vínculo: encaminha-se também quem
/// ainda não tem ficha na clínica.
model Encaminhamento {
  id           String   @id @default(cuid())
  dataEmissao  DateTime @default(now())
  pacienteNome String
  texto        String
  /// Nome do documento impresso no topo: "Encaminhamento", "Atestado",
  /// "Declaração"... livre, digitado pelo profissional.
  titulo       String   @default("Encaminhamento")

  profissionalId String?
  profissional   Usuario? @relation("ProfissionalDoEncaminhamento", fields: [profissionalId], references: [id], onDelete: SetNull)

  consultorioId String
  consultorio   Consultorio @relation(fields: [consultorioId], references: [id], onDelete: Cascade)

  @@index([consultorioId])
  @@map("encaminhamentos")
}

/// Aviso na campainha do topo. Uma linha por destinatário: com equipe pequena
/// isso custa quase nada e evita ter que guardar "quem já leu" numa tabela à
/// parte, que é onde esse tipo de recurso costuma virar bagunça.
model Notificacao {
  id        String    @id @default(cuid())
  tipo      String
  titulo    String
  descricao String?
  /// Para onde o clique leva (ex: /agenda).
  link      String?
  lidaEm    DateTime?
  criadoEm  DateTime  @default(now())

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  /// Nulo nas notificações do SUPER_ADMIN, que não pertence a consultório.
  consultorioId String?
  consultorio   Consultorio? @relation(fields: [consultorioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, criadoEm])
  @@map("notificacoes")
}

enum StatusChamado {
  ABERTO
  EM_ATENDIMENTO
  RESOLVIDO
}

enum AutorMensagem {
  USUARIO
  AGENTE
  SUPORTE
}

/// Conversa de suporte. Nasce sempre com o agente automático respondendo e
/// só vira atendimento humano quando a pessoa pede — assim ninguém fica
/// esperando resposta para uma dúvida que a base já responde.
model Chamado {
  id           String        @id @default(cuid())
  assunto      String
  status       StatusChamado @default(ABERTO)
  /// Verdadeiro depois que a conversa foi passada para uma pessoa.
  escalado     Boolean       @default(false)
  criadoEm     DateTime      @default(now())
  atualizadoEm DateTime      @updatedAt

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  consultorioId String
  consultorio   Consultorio @relation(fields: [consultorioId], references: [id], onDelete: Cascade)

  mensagens MensagemChamado[]

  @@index([consultorioId, atualizadoEm])
  @@index([escalado, status])
  @@map("chamados")
}

model MensagemChamado {
  id       String        @id @default(cuid())
  autor    AutorMensagem
  texto    String        @db.Text
  criadoEm DateTime      @default(now())

  chamadoId String
  chamado   Chamado @relation(fields: [chamadoId], references: [id], onDelete: Cascade)

  @@index([chamadoId, criadoEm])
  @@map("mensagens_chamado")
}

/// Um pedaço de expediente num dia da semana.
///
/// Existe como tabela, e não como duas colunas no consultório, porque a vida
/// real não cabe num par único: seg a sex das 8 às 18, sábado só até meio-dia,
/// e quem fecha para almoço tem dois blocos no mesmo dia. Cada linha é um
/// intervalo contínuo em que a clínica atende.
///
/// As colunas horaAbertura/horaFechamento do consultório continuam existindo
/// como padrão de quem ainda não montou os blocos — e foi assim que os
/// consultórios já cadastrados ganharam a grade inicial sem intervenção.
model BlocoExpediente {
  id        String @id @default(cuid())
  /// 0 = domingo … 6 = sábado, no padrão do Date.getDay().
  diaSemana Int
  /// Minutos desde a meia-noite: 8h = 480, 12h30 = 750. Guardar em minuto
  /// evita a dupla hora+minuto e permite meia hora sem campo extra.
  inicioMin Int
  fimMin    Int

  consultorioId String
  consultorio   Consultorio @relation(fields: [consultorioId], references: [id], onDelete: Cascade)

  @@index([consultorioId, diaSemana])
  @@map("blocos_expediente")
}

/// Período em que um profissional não atende (férias, curso, consulta
/// médica). Nenhum agendamento — público ou interno — cai dentro dele.
/// Guardado como instante exato: dia inteiro vira 00h do primeiro dia até
/// 00h do dia seguinte ao último, no fuso do consultório.
model Ausencia {
  id     String   @id @default(cuid())
  inicio DateTime
  fim    DateTime
  motivo String?

  profissionalId String
  profissional   Usuario @relation(fields: [profissionalId], references: [id], onDelete: Cascade)

  consultorioId String
  consultorio   Consultorio @relation(fields: [consultorioId], references: [id], onDelete: Cascade)

  @@index([consultorioId, profissionalId, inicio])
  @@map("ausencias")
}

/// Grupo de consultórios sob um mesmo gestor — franquia, ou as várias
/// clínicas de um mesmo dono. Criada e montada pelo administrador do SaaS.
/// O isolamento entre clínicas continua: só o ambiente /gestor lê mais de um
/// consultório, e sempre pela lista de unidades desta rede, lida do banco.
model Rede {
  id           String        @id @default(cuid())
  nome         String
  criadoEm     DateTime      @default(now())
  consultorios Consultorio[]
  gestores     Usuario[]

  @@map("redes")
}

/// Máximo de telas que um papel pode abrir numa unidade, definido pelo
/// gestor. O dono da clínica ajusta cada pessoa só dentro deste limite.
model TetoAcesso {
  consultorioId String
  consultorio   Consultorio @relation(fields: [consultorioId], references: [id], onDelete: Cascade)
  papel         Papel
  telas         String[]

  @@id([consultorioId, papel])
  @@map("tetos_acesso")
}

/// (Obsoleto — substituído por Rede.) Dono com mais de uma unidade. A pessoa tem UM consultório de origem
/// (Usuario.consultorioId) e ganha acesso de dono aos listados aqui. O
/// isolamento não muda: a sessão aponta para um consultório por vez, e toda
/// query continua filtrando por ele.
model AcessoConsultorio {
  usuarioId     String
  usuario       Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  consultorioId String
  consultorio   Consultorio @relation(fields: [consultorioId], references: [id], onDelete: Cascade)
  criadoEm      DateTime    @default(now())

  @@id([usuarioId, consultorioId])
  @@map("acessos_consultorio")
}

enum StatusFatura {
  ABERTA
  PAGA
  CANCELADA
}

/// Mensalidade de um consultório.
///
/// Duas origens: lançada à mão pelo administrador (PIX manual, baixa manual)
/// ou gerada pela assinatura no Asaas (baixa automática pelo webhook). Em
/// nenhum caso há dado de cartão aqui — o checkout é todo no Asaas.
model Fatura {
  id               String       @id @default(cuid())
  /// Mês de referência no formato AAAA-MM.
  competencia      String
  descricao        String?
  valor            Decimal      @db.Decimal(10, 2)
  vencimento       DateTime
  status           StatusFatura @default(ABERTA)
  pagoEm           DateTime?
  /// Anotação livre de quem confirmou: "PIX recebido dia 03", por exemplo.
  observacao       String?
  /// Preenchidos quando a fatura nasce de uma cobrança do Asaas: a baixa
  /// chega pelo webhook, sem confirmação manual.
  asaasPagamentoId String?      @unique
  linkPagamento    String?
  formaPagamento   String?
  criadoEm         DateTime     @default(now())

  consultorioId String
  consultorio   Consultorio @relation(fields: [consultorioId], references: [id], onDelete: Cascade)

  @@index([consultorioId, vencimento])
  @@index([status, vencimento])
  @@map("faturas")
}

/// Parâmetros do SaaS — uma linha só, editada pelo administrador.
///
/// Fica no banco em vez de variável de ambiente para o dono do sistema poder
/// trocar a chave PIX sem depender de um deploy.
model ParametrosSaas {
  id              String   @id @default("unico")
  pixChave        String?
  pixBeneficiario String?
  pixCidade       String?
  /// Quantos dias depois do vencimento o acesso continua liberado.
  diasCarencia    Int      @default(5)
  atualizadoEm    DateTime @updatedAt

  @@map("parametros_saas")
}

/// Trilha de auditoria imutável. Só INSERT, nunca UPDATE/DELETE.
/// Registra ações sensíveis: criação/edição de pacientes, emissão de receitas,
/// acesso a prontuários, gestão de usuários.
model LogAuditoria {
  id         String   @id @default(cuid())
  acao       String
  entidade   String
  entidadeId String?
  detalhes   String?  @db.Text
  ip         String?
  criadoEm   DateTime @default(now())

  usuarioId String?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  consultorioId String?
  consultorio   Consultorio? @relation(fields: [consultorioId], references: [id], onDelete: SetNull)

  @@index([consultorioId, criadoEm])
  @@index([entidade, entidadeId])
  @@map("logs_auditoria")
}

/// Tentativas de login para rate limiting sem depender de Redis externo.
/// Linhas antigas são varridas periodicamente ou via cron.
model TentativaLogin {
  id       String   @id @default(cuid())
  email    String
  ip       String
  criadoEm DateTime @default(now())

  @@index([email, criadoEm])
  @@index([ip, criadoEm])
  @@map("tentativas_login")
}

// ─── Assistente IA ────────────────────────────────────────────────────────
// Lotes de pacientes para reativar, aprovados pela clínica antes de qualquer
// contato. Ver docs/superpowers/specs/2026-11-19-assistente-ia-design.md.

enum TipoLoteIA {
  EXAME_VENCIDO
  RECEITA_VENCIDA
  FALTOU
  SUMIDO
  INATIVO_6M
}

enum StatusLoteIA {
  PROPOSTO
  APROVADO
  PAUSADO
  CONCLUIDO
  DESCARTADO
}

enum StatusContatoLote {
  AGUARDANDO
  LIBERADO
  ENVIADO
  AGENDOU
  RECUSOU
  NAO_CONTATAR
}

model LoteIA {
  id               String        @id @default(cuid())
  consultorioId    String
  consultorio      Consultorio   @relation(fields: [consultorioId], references: [id], onDelete: Cascade)
  tipo             TipoLoteIA
  status           StatusLoteIA  @default(PROPOSTO)
  ritmoDiario      Int           @default(20)
  aprovadoPorId    String?
  aprovadoEm       DateTime?
  /// Registro de quem autorizou o envio automático e o texto que aceitou.
  iniciaEm         DateTime?
  autorizadoPorId  String?
  autorizadoEm     DateTime?
  textoAutorizacao String?
  criadoEm         DateTime      @default(now())
  contatos         ContatoLote[]

  @@index([consultorioId, status])
  @@map("lotes_ia")
}

model ContatoLote {
  id            String            @id @default(cuid())
  loteId        String
  lote          LoteIA            @relation(fields: [loteId], references: [id], onDelete: Cascade)
  pacienteId    String
  paciente      Paciente          @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  consultorioId String
  consultorio   Consultorio       @relation(fields: [consultorioId], references: [id], onDelete: Cascade)
  ordem         Int
  prioridade    String?
  motivoIA      String?
  mensagem      String?
  dias          Int
  status        StatusContatoLote @default(AGUARDANDO)
  liberadoEm    DateTime?
  enviadoEm     DateTime?
  enviarEm      DateTime?
  atualizadoEm  DateTime          @updatedAt
  conversa      ConversaIA?

  @@unique([loteId, pacienteId])
  @@index([consultorioId, pacienteId])
  @@index([loteId, status])
  @@map("contatos_lote")
}

model AnaliseIA {
  id            String      @id @default(cuid())
  consultorioId String
  consultorio   Consultorio @relation(fields: [consultorioId], references: [id], onDelete: Cascade)
  conteudo      Json
  criadoEm      DateTime    @default(now())

  @@index([consultorioId, criadoEm])
  @@map("analises_ia")
}

// ─── Assistente IA, etapa 2: WhatsApp automático (Z-API) ──────────────────

enum StatusWhatsapp {
  SEM_INSTANCIA
  EM_CONFIGURACAO
  DESCONECTADO
  CONECTADO
}

enum TipoConversa {
  POS_VENDA
  RECUPERACAO
}

enum StatusConversa {
  AGUARDANDO_ENVIO
  ABERTA
  COM_EQUIPE
  RESOLVIDA
  SEM_RESPOSTA
  ENCERRADA
}

enum DirecaoMensagem {
  SAIDA
  ENTRADA
}

/// Não reaproveita AutorMensagem: esse nome já é do chat de suporte (Chamado).
enum AutorMensagemIA {
  IA
  PACIENTE
  EQUIPE
}

model ConversaIA {
  id                String         @id @default(cuid())
  consultorioId     String
  consultorio       Consultorio    @relation(fields: [consultorioId], references: [id], onDelete: Cascade)
  pacienteId        String
  paciente          Paciente       @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  tipo              TipoConversa
  status            StatusConversa @default(AGUARDANDO_ENVIO)
  /// Uma conversa de pós-venda por consulta e uma por contato de lote.
  consultaId        String?        @unique
  contatoLoteId     String?        @unique
  contatoLote       ContatoLote?   @relation(fields: [contatoLoteId], references: [id], onDelete: SetNull)
  enviarEm          DateTime?
  motivoEquipe      String?
  prioridade        String?
  aberturaEnviadaEm DateTime?
  /// Horário do ÚLTIMO lembrete; a contagem fica em lembretesEnviados.
  lembreteEnviadoEm DateTime?
  lembretesEnviados Int            @default(0)
  ultimaRespostaEm  DateTime?
  criadoEm          DateTime       @default(now())
  atualizadoEm      DateTime       @updatedAt
  mensagens         MensagemIA[]

  @@index([consultorioId, status])
  @@index([consultorioId, pacienteId])
  @@map("conversas_ia")
}

model MensagemIA {
  id             String          @id @default(cuid())
  conversaId     String
  conversa       ConversaIA      @relation(fields: [conversaId], references: [id], onDelete: Cascade)
  consultorioId  String
  direcao        DirecaoMensagem
  autor          AutorMensagemIA
  texto          String          @db.Text
  /// Usuário da equipe que escreveu (autor EQUIPE).
  autorUsuarioId String?
  /// Id da mensagem na Z-API: barra entrega duplicada do webhook.
  idProvedor     String?         @unique
  criadoEm       DateTime        @default(now())

  @@index([conversaId, criadoEm])
  @@map("mensagens_ia")
}

enum TomIA {
  AMIGAVEL
  PROFISSIONAL
  DIRETO
  ENTUSIASMADO
}

model AgenteIA {
  id                      String       @id @default(cuid())
  consultorioId           String
  consultorio             Consultorio  @relation(fields: [consultorioId], references: [id], onDelete: Cascade)
  tipo                    TipoConversa
  nome                    String
  tom                     TomIA        @default(AMIGAVEL)
  gatilhos                String[]
  desinteresseNaoContatar Boolean      @default(false)
  horario                 Json
  cadenciaDias            Int[]
  seNaoResponderEquipe    Boolean      @default(false)
  notificarUsuarioId      String?
  ativo                   Boolean      @default(true)
  criadoEm                DateTime     @default(now())
  atualizadoEm            DateTime     @updatedAt

  @@unique([consultorioId, tipo])
  @@map("agentes_ia")
}

model ItemConhecimentoIA {
  id            String      @id @default(cuid())
  consultorioId String
  consultorio   Consultorio @relation(fields: [consultorioId], references: [id], onDelete: Cascade)
  titulo        String
  texto         String      @db.Text
  ordem         Int         @default(0)
  criadoEm      DateTime    @default(now())
  atualizadoEm  DateTime    @updatedAt

  @@index([consultorioId, ordem])
  @@map("conhecimento_ia")
}
